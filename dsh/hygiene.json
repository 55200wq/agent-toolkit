{
 "_说明": "dsh-tools 的脚本卫生口径（复用 agent-toolkit 的 hygiene_check.py ✓）。",
 "_H3说明": "stdout 与 stderr 都要兜底（只兜 stdout ⇒ stderr 报错仍乱码 ✗）；存量脚本用 tools/script-hygiene/fix_bootstrap.py 整类升级 ✓。",
 "scan": ["tools/**/*.py"],
 "exclude": [".git/**", "**/__pycache__/**"],
 "rules": {"H1": true, "H2": true, "H3": true},
 "bootstrap_markers": ["reconfigure(encoding", "TextIOWrapper(sys.stdout.buffer", "PYTHONIOENCODING"],
 "bootstrap_stderr_markers": ["_sys_h.stderr", "sys.stderr.reconfigure",
                              "TextIOWrapper(sys.stderr.buffer)", "(sys.stdout, sys.stderr)"],
 "h3_ignore_files": []
}
