{
 "_说明": "agent-tools 自己也要过自己的溯源检查（自举）。",
 "scan": ["tools/**/*.py", "install/*.py"],
 "exclude": [".git/**", "**/__pycache__/**"],
 "tags": {
  "untested": ["依据: 未实测"],
  "measured": ["依据: 实测"],
  "mechanism": ["依据: 机制"],
  "semantic": ["依据: 语义"]
 },
 "lookback_lines": 6,
 "exempt_name_patterns": ["^_", "_T$", "_TS$"],
 "exempt_self_names": ["t", "pos", "x", "y"],
 "semantic_names": [],
 "logic_values": ["0", "1", "2", "-1"],
 "assumptions_out": "docs/unmeasured.json",
 "assumptions_note": "agent-tools 自身的未实测初值清单（自动生成，勿手改）。",
 "premise": "本工具集不含项目知识；各项目的像素/时间阈值在各自项目里标定。"
}
