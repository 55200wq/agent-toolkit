{
 "_说明": "脚本卫生口径（编译/路径转义/输出编码）。改 scan/exclude 适配你的项目。",
 "scan": ["**/*.py"],
 "exclude": [".git/**", ".venv/**", "venv/**", "node_modules/**", "**/__pycache__/**",
             "**/vendor/**", "**/third_party/**"],
 "rules": {"H1": true, "H2": true, "H3": true},
 "bootstrap_markers": ["reconfigure(encoding", "TextIOWrapper(sys.stdout.buffer", "PYTHONIOENCODING"],
 "h3_ignore_files": []
}
